{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fir-service",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d ly-project\\fir-service && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "ly-project/server"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "ly-project/web"],
      "port": 5173
    }
  ]
}
